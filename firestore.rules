rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Robust Helper Functions (Null-Safe) ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isRole(role) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "ou2sema@gmail.com" || 
        isRole("admin")
      );
    }

    function isGerant() {
      return isAdmin() || isRole("gerant");
    }

    function isServeur() {
      return isGerant() || isRole("serveur");
    }

    // --- Collections Rules (Permissive fallbacks to support fallback operation when anonymous/custom auth fails) ---

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Products Collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // 2b. Categories Collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // 2c. Settings Collection
    match /settings/{settingsId} {
      allow read, write: if true;
    }

    // 3. Transactions Collection
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // 4. Inventory Logs Collection
    match /inventory_logs/{logId} {
      allow read, write: if true;
    }
  }
}
